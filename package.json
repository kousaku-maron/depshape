{
  "name": "@kousaku-maron/depshape",
  "version": "0.1.0",
  "description": "Visualize how a git diff changes folder/file dependencies, side by side with existing siblings",
  "keywords": [
    "dependency",
    "dependencies",
    "diff",
    "code-review",
    "review",
    "go",
    "golang",
    "visualization",
    "cli",
    "ai"
  ],
  "homepage": "https://github.com/kousaku-maron/depshape#readme",
  "bugs": {
    "url": "https://github.com/kousaku-maron/depshape/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kousaku-maron/depshape.git"
  },
  "license": "MIT",
  "author": "kousaku-maron",
  "type": "module",
  "bin": {
    "depshape": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:ui && npm run build:cli",
    "build:cli": "tsc -p tsconfig.json",
    "build:ui": "vite build",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
