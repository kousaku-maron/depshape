{
  "name": "@kousaku-maron/diffshape",
  "version": "0.7.0",
  "description": "See a git diff as the shape of what it changes: the line diff of every file (like difit), code dependencies (Go, TypeScript, JavaScript) and the PostgreSQL schema, side by side with what already exists",
  "keywords": [
    "diff",
    "syntax-highlighting",
    "diff-viewer",
    "code-review",
    "review",
    "dependency",
    "dependencies",
    "database",
    "schema",
    "postgresql",
    "er-diagram",
    "go",
    "typescript",
    "javascript",
    "visualization",
    "cli",
    "ai"
  ],
  "homepage": "https://github.com/kousaku-maron/diffshape#readme",
  "bugs": {
    "url": "https://github.com/kousaku-maron/diffshape/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kousaku-maron/diffshape.git",
    "directory": "packages/diffshape"
  },
  "license": "MIT",
  "author": "kousaku-maron",
  "type": "module",
  "bin": {
    "diffshape": "dist/bin/diffshape.js",
    "fileshape": "dist/bin/fileshape.js",
    "depshape": "dist/bin/depshape.js",
    "dbshape": "dist/bin/dbshape.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:ui && npm run build:cli",
    "build:cli": "esbuild src/bin/diffshape.ts src/bin/fileshape.ts src/bin/depshape.ts src/bin/dbshape.ts --bundle --splitting --platform=node --format=esm --target=node20 --outdir=dist/bin --external:libpg-query --log-level=warning",
    "build:ui": "vite build",
    "dev": "tsx src/bin/diffshape.ts",
    "test": "vitest run --root .",
    "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "libpg-query": "18.2.2"
  },
  "devDependencies": {
    "@diffshape/core": "workspace:*",
    "@diffshape/dbshape": "workspace:*",
    "@diffshape/depshape": "workspace:*",
    "@diffshape/fileshape": "workspace:*",
    "@diffshape/ui": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.23.1",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.1.0",
    "remark-gfm": "4.0.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
