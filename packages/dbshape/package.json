{
  "name": "@diffshape/dbshape",
  "private": true,
  "description": "The dbshape module of diffshape: how a git diff changes a PostgreSQL schema, read from the SQL files in the repo. Bundled into the diffshape app, not published on its own.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./ui/src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json --noEmit"
  },
  "dependencies": {
    "libpg-query": "18.2.2"
  },
  "devDependencies": {
    "@dagrejs/dagre": "2.0.4",
    "@diffshape/core": "workspace:*",
    "@diffshape/ui": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.12",
    "react": "18.3.1",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
