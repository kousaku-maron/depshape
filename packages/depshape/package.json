{
  "name": "@diffshape/depshape",
  "private": true,
  "description": "The depshape module of diffshape: how a git diff changes folder / file dependencies (Go, TypeScript, JavaScript). Bundled into the diffshape app, not published on its own.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./ui/src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@diffshape/core": "workspace:*",
    "@diffshape/ui": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.12",
    "react": "18.3.1",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
